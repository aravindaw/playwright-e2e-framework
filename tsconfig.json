{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@testData/*": ["test_data/*"],
      "@pageObjects/*": ["page_objects/*"],
      "@enums/*": ["enums/*"],
      "@fixture/*": ["tests/fixtures/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
